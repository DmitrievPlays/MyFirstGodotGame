; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Somefactory"
config/version="0.0.8.1"
run/main_scene="res://scenes/LandingPage.tscn"
config/auto_accept_quit=false
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
run/max_fps=60
boot_splash/bg_color=Color(0.17951, 0.181213, 0.230469, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/image="uid://b2hwtcxx6m8xo"
config/icon="res://textures/icon.png"

[audio]

buses/default_bus_layout=""

[autoload]

SettingsHandler="*res://scenes/settings/SettingsHandler.cs"
GameServer="*res://scripts/multiplayer/GameServer.cs"
PauseHandler="*res://scenes/pause/PauseHandler.cs"
LobbyHandler="*res://scenes/lobby/LobbyHandler.cs"
ExitDialog="*res://scenes/ExitDialog.tscn"
SceneCache="*res://scripts/SceneCache.cs"
CurrentPlayerData="*res://scripts/player/CurrentPlayerData.cs"

[debug]

gdscript/warnings/enable=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Somefactory"

[editor]

run/main_run_args="--gpu-index 1"

[editor_plugins]

enabled=PackedStringArray("res://addons/Basic FPS Player/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[gui]

theme/custom="uid://ct2c6000jdvam"
theme/custom_font="uid://nu6bkmdnorej"

