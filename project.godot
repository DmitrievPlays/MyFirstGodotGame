[internationalization]

locale/translation_remaps={}
locale/translations=PackedStringArray("res://translations/translations.en.translation", "res://translations/translations.ru.translation")
locale/include_text_server_data=true
locale/test="play"
locale/locale_filter_mode=0

[navigation]

3d/size/viewport_width=1600
3d/size/viewport_height=900

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/default_filters/anisotropic_filtering_level=0
environment/ssao/quality=0
environment/ssil/quality=0
environment/glow/upscale_mode=0
environment/screen_space_reflection/roughness_quality=0
anti_aliasing/quality/screen_space_aa=1
